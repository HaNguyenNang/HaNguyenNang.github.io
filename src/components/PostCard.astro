---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate, readingTime } from '../data/utils';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<a href={url(`/blog/${post.id}/`)} class="card post-card" data-tags={tags.join('|')}>
  <div class="meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <span>{readingTime(post.body)} phút đọc</span>
  </div>
  <h3>{title}</h3>
  <p class="muted">{description}</p>
  <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--mist);
    margin-bottom: 10px;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  .post-card:hover h3 {
    color: var(--accent);
  }

  p {
    margin: 0 0 16px;
    font-size: 0.95rem;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
