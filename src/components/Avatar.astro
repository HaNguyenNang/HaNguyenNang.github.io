---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { profile } from '../data/profile';

interface Props {
  size?: number;
  eager?: boolean;
}

const { size = 420, eager = false } = Astro.props;
---

<div class="avatar" style={`--size:${size}px`}>
  <Image
    src={avatar}
    alt={`Ảnh đại diện ${profile.name}`}
    width={size * 2}
    height={size * 2}
    format="webp"
    quality={82}
    loading={eager ? 'eager' : 'lazy'}
  />
</div>

<style>
  .avatar {
    position: relative;
    width: var(--size);
    max-width: 100%;
    aspect-ratio: 1;
  }

  .avatar::before {
    content: '';
    position: absolute;
    inset: 14px -14px -14px 14px;
    border: 1px solid var(--accent);
    border-radius: 20px;
    opacity: 0.55;
  }

  .avatar img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid var(--line-strong);
  }
</style>
