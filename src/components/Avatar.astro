---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { profile } from '../data/profile';

interface Props {
  size?: number;
  eager?: boolean;
}

const { size = 420, eager = false } = Astro.props;
---

<div class="avatar" style={`--size:${size}px`}>
  <Image
    src={avatar}
    alt={`Ảnh đại diện ${profile.name}`}
    width={size * 2}
    height={size * 2}
    format="webp"
    quality={85}
    loading={eager ? 'eager' : 'lazy'}
  />
</div>

<style>
  /* Ảnh tách nền: nhân vật đứng trên tấm nền, phần đầu nhô lên khỏi khung. */
  .avatar {
    position: relative;
    width: var(--size);
    max-width: 100%;
    aspect-ratio: 1;
    isolation: isolate;
  }

  .avatar::before,
  .avatar::after {
    content: '';
    position: absolute;
    border-radius: 24px;
  }

  .avatar::before {
    inset: 22% 0 0 0;
    z-index: 1;
    background: radial-gradient(circle at 50% 18%, rgba(233, 172, 82, 0.28), transparent 62%),
      linear-gradient(165deg, #22324a, #131a26 75%);
    border: 1px solid var(--line-strong);
  }

  .avatar::after {
    inset: calc(22% + 14px) -14px -14px 14px;
    z-index: 0;
    border: 1px solid var(--accent);
    opacity: 0.5;
  }

  .avatar img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    border-radius: 0 0 24px 24px;
  }
</style>
