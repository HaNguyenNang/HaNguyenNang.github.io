---
import type { CollectionEntry } from 'astro:content';
import { url } from '../data/utils';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { title, description, genres, platforms, cover, color, play, releaseDate } = game.data;
---

<a href={url(`/games/${game.id}/`)} class="card game-card" data-genres={genres.join('|')}>
  <div class="thumb" style={`--c:${color}`}>
    {cover ? <img src={url(cover)} alt={title} loading="lazy" /> : <span class="placeholder">{title}</span>}
    {play && <span class="badge">▶ Chơi trên web</span>}
  </div>
  <div class="body">
    <div class="meta">
      <span>{genres.join(' · ')}</span>
      <span>{releaseDate.getFullYear()}</span>
    </div>
    <h3>{title}</h3>
    <p class="muted">{description}</p>
    <div class="tags">{platforms.map((p) => <span class="tag">{p}</span>)}</div>
  </div>
</a>

<style>
  .game-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 35%, var(--surface-2)), var(--surface-2));
    border-bottom: 1px solid var(--line);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .game-card:hover .thumb img {
    transform: scale(1.04);
  }

  .placeholder {
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.85);
    padding: 0 24px;
    text-align: center;
  }

  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    background: rgba(12, 17, 26, 0.8);
    backdrop-filter: blur(6px);
    color: var(--accent);
    border: 1px solid rgba(233, 172, 82, 0.4);
    border-radius: 999px;
  }

  .body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--mist);
    margin-bottom: 8px;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 6px;
  }

  p {
    margin: 0 0 16px;
    font-size: 0.95rem;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
