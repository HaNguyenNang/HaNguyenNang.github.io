---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getGames } from '../../data/utils';

const games = await getGames();
const genres = [...new Set(games.flatMap((g) => g.data.genres))].sort();
---

<Base title="Dự án" description="Các dự án game của Nguyễn Năng Hà — phần lớn có thể chơi trực tiếp trên trình duyệt.">
  <div class="container">
    <div class="page-head">
      <span class="eyebrow">Dự án</span>
      <h1>Các game đã thực hiện</h1>
      <p>Tuyển tập sản phẩm tôi đã phát triển. Phần lớn có thể chơi trực tiếp trên trình duyệt mà không cần cài đặt.</p>
    </div>

    <section>
      <FilterBar options={genres} attr="genres" />
      {
        games.length ? (
          <div class="grid" data-filter-target>
            {games.map((game) => (
              <GameCard game={game} />
            ))}
          </div>
        ) : (
          <div class="card empty">
            <h3>Dự án đang được cập nhật</h3>
            <p class="muted">Các sản phẩm sẽ sớm xuất hiện tại đây.</p>
          </div>
        )
      }
    </section>
  </div>
</Base>
