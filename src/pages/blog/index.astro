---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getPosts } from '../../data/utils';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Blog" description="Kiến thức và kinh nghiệm phát triển game của Nguyễn Năng Hà.">
  <div class="container">
    <div class="page-head">
      <span class="eyebrow">Blog</span>
      <h1>Kiến thức & Kinh nghiệm</h1>
      <p>Ghi chép về kỹ thuật, quy trình và những bài học thực tế trong quá trình phát triển game.</p>
    </div>

    <section>
      <FilterBar options={tags} attr="tags" />
      {
        posts.length ? (
          <div class="grid" data-filter-target>
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="card empty">
            <h3>Bài viết đang được chuẩn bị</h3>
            <p class="muted">Hãy quay lại sau nhé.</p>
          </div>
        )
      }
    </section>
  </div>
</Base>
